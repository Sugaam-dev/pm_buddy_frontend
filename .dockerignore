# ================================================
# PM Buddy Frontend - .dockerignore
# Excludes local node_modules, build outputs, and secrets from Docker builds
# ================================================

# 1. Git & Version Control
.git/
.gitignore

# 2. Dependencies (Must be installed clean inside container)
node_modules/

# 3. Next.js & Build Caches
.next/
out/
dist/
.cache/
*.tsbuildinfo
.vercel/

# 4. Local Secrets & Environment Files
.env
.env.*
!.env.example
!.env.template

# 5. Testing & Quality Assurance
coverage/
test-results/
playwright-report/
blob-report/
tests/

# 6. Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
*.tmp

# 7. IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
