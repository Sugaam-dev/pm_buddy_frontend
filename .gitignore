# ================================================
# PM Buddy Frontend - .gitignore
# Next.js / React / TypeScript production safety rules
# ================================================

# 1. Environment & Secrets
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.token
*.credentials

# 2. Node Dependencies
node_modules/

# 3. Next.js Build Outputs & Caches
.next/
out/
dist/
*.tsbuildinfo
.vite/
.vercel/

# 4. Package Manager Logs & Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# 5. Testing & Coverage Reports
coverage/
test-results/
playwright-report/
blob-report/

# 6. Logs & Temporary Files
*.log
logs/
tmp/
temp/
.cache/
*.tmp
*.temp

# 7. IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 8. Source Maps (Production Option)
*.map

# 9. Local AI & Tool Caches
.ai/
.ai-cache/
.agent-cache/