# Public API URL pointing to the backend hosted on Hostinger
# In production on Vercel, set this to your domain e.g., https://api.pmrg.in
NEXT_PUBLIC_BACKEND_URL=https://api.yourdomain.com

# Supabase Authentication & Database client (Optional if calling backend auth API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
